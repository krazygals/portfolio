---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ProjectGrid from "../components/ProjectGrid.astro";

const eyebrow = ""; // no top tagline
const title = "PROJECTS + CASE STUDIES";
const location = "Analytics • AI Pipelines • Full-Stack Apps";

const technologies = [
  "astro",
  "react",
  "typeScript",
  "tailwindcss",
  "nodejs",
  "python",
  "sentence-transformers",
  "FAISS",
  "HTML5",
  "CSS3",
  "javaScript",
  "git",
  "mysql",
  "bash",
  "flask",
  "fastAPI",
];
---

<Base>
  <!-- hero: wrap in .work-hero so we can target it just on this page -->
  <section class="work-hero">
    <Hero {eyebrow} {title} {location} />
  </section>

  <section class="full-bleed">
    <div class="px-6 md:px-8 pt-0 md:pt-0 -mt-6 md:-mt-8">
      <!-- top purple line -->
      <div class="border-t ink-rule my-4"></div>

    <!-- 🔮 Logo Wall positioned between the existing lines -->
    <div class="px-0 md:px-0">
      <div class="relative overflow-x-hidden py-1 md:py-2">
        <div class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-ink-950 to-transparent z-20"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-ink-950 to-transparent z-20"></div>

        <div class="flex animate-scroll hover:animate-paused gap-10 md:gap-16 w-max">
          {
            [...technologies, ...technologies].map((tech) => (
              <span
                class="text-base md:text-lg font-medium tracking-wide uppercase text-neon-500 opacity-75 hover:opacity-100 transition-all duration-300"
              >
                {tech}
              </span>
            ))
          }
        </div>
      </div>
    </div>

      <!-- bottom purple line -->
      <div class="border-t ink-rule my-4"></div>

      <!-- project grid -->
      <ProjectGrid />
    </div>
  </section>
</Base>

<style is:global>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .animate-scroll {
    animation: scroll 60s linear infinite;
  }

  .animate-paused {
    animation-play-state: paused;
  }

  @media (min-width: 768px) {
    .animate-scroll {
      animation-duration: 45s;
    }
  }
</style>

<!-- 🔧 REAL override: affects Hero only on /work -->
<style is:global>
  /* Work page only: hide the two lines + eyebrow under the big headline */
  .work-hero .border-t.ink-rule {
    display: none;
  }

  .work-hero p.text-center {
    display: none;
  }
</style>
