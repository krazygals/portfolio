---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";

const eyebrow = "LET’S BUILD SOMETHING TOGETHER!";
const title = "CONTACT";
const location = "Available for freelance & collaborations.";
---

<Base>
  <!-- header -->
  <Hero {eyebrow} {title} {location} />

  <!-- contact section -->
  <section class="px-6 md:px-8">
    <div class="py-10 md:py-14">

      <!-- Contact boxes -->
      <div class="band grid gap-6 grid-cols-1 md:grid-cols-[repeat(auto-fit,minmax(260px,1fr))]">
        <div class="box self-start p-4" data-react>
          <div class="eyebrow">Email</div>
          <div class="mt-2 break-words">
            <a href="mailto:orianaolmstead@gmail.com" class="hover:underline">
              orianaolmstead@gmail.com
            </a>
          </div>
        </div>

        <div class="box self-start p-4" data-react>
          <div class="eyebrow">LinkedIn</div>
          <div class="mt-2 break-words pr-1">
            <a
              href="https://www.linkedin.com/in/orianaolmstead"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline inline-block max-w-full"
            >
              linkedin.com<wbr>/in/orianaolmstead
            </a>
          </div>
        </div>

        <div class="box self-start p-4" data-react>
          <div class="eyebrow">GitHub</div>
          <div class="mt-2 break-words">
            <a
              href="https://github.com/krazygals"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline"
            >
              github.com/krazygals
            </a>
          </div>
        </div>
      </div>

      <div class="border-t ink-rule my-8"></div>

      <!-- In-theme messaging form -->
      <form id="contactForm" action="https://formspree.io/f/myzlkpny" method="POST" class="mt-2 max-w-2xl">
        <div class="box p-4 space-y-4" data-react>
          <div>
            <label class="eyebrow block mb-2" for="name">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="w-full bg-transparent border ink-rule rounded-none px-3 py-2 outline-none focus:ring-0"
              placeholder="Your name"
            />
          </div>

          <div>
            <label class="eyebrow block mb-2" for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="w-full bg-transparent border ink-rule rounded-none px-3 py-2 outline-none focus:ring-0"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label class="eyebrow block mb-2" for="message">Message</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              class="w-full bg-transparent border ink-rule rounded-none px-3 py-2 outline-none focus:ring-0"
              placeholder="Tell me about your project, timeline, and budget (optional)."
            ></textarea>
          </div>

          <!-- Honeypot -->
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

          <div class="flex items-center gap-3">
            <button
              id="contactSubmit"
              type="submit"
              class="inline-flex items-center gap-2 border ink-rule text-[color-mix(in srgb, var(--color-brand) 60%, white 40%)] hover:text-[var(--color-brand)] hover:border-[var(--color-brand)] font-semibold py-2 px-5 rounded-none bg-transparent transition-all"
            >
              <span class="btn-label">Send Message</span>
              <span class="spinner hidden"></span>
            </button>


          </div>

          <div id="formStatus" class="hidden mt-4 border ink-rule p-3 text-sm"></div>
        </div>
      </form>

    </div>
  </section>
</Base>

<!-- Inline script for no-redirect Formspree submission -->
<script is:inline>
  const form = document.getElementById('contactForm');
  const btn = document.getElementById('contactSubmit');
  const label = btn?.querySelector('.btn-label');
  const spinner = btn?.querySelector('.spinner');
  const statusBox = document.getElementById('formStatus');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    btn.disabled = true;
    statusBox.classList.add('hidden');
    label.textContent = 'Sending…';
    spinner?.classList.remove('hidden');

    try {
      const data = new FormData(form);
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { 'Accept': 'application/json' }
      });

      if (res.ok) {
        form.reset();
        form.classList.add('sent');
        statusBox.textContent = 'Thanks! Your message has been sent.';
        statusBox.classList.remove('hidden');
        label.textContent = 'Sent ✓';
      } else {
        throw new Error('Something went wrong. Please try again.');
      }
    } catch (err) {
      statusBox.textContent = String(err.message || err);
      statusBox.classList.remove('hidden');
      label.textContent = 'Try again';
    } finally {
      spinner?.classList.add('hidden');
      btn.disabled = false;
    }
  });
</script>

<style is:global>
  .spinner::after {
    content: '';
    width: 6px; height: 6px;
    border-radius: 9999px;
    background: var(--color-brand);
    display: inline-block;
    animation: pulse 0.9s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: .25; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.35); }
  }

  #contactForm.sent .box {
    box-shadow: 0 0 0 0 rgba(168,85,247,0);
    animation: sentGlow 900ms ease-out;
  }

  @keyframes sentGlow {
    0%   { box-shadow: 0 0 0 0 rgba(168,85,247,0); }
    40%  { box-shadow: 0 0 24px 0 rgba(168,85,247,0.35); }
    100% { box-shadow: 0 0 0 0 rgba(168,85,247,0); }
  }
</style>
