---
const {
  pdf = "",
  title = "Report",
  height = 520,
  id = "pdfv-" + Math.random().toString(36).slice(2),
} = Astro.props;
---


<style>
  .viewer{position:relative;border-radius:.75rem;border:1px solid rgba(255,255,255,.10);
    background:linear-gradient(180deg,rgba(8,8,10,.85),rgba(6,6,8,.9));box-shadow:0 10px 30px rgba(0,0,0,.35);overflow:hidden}
  .viewer::before{content:"";position:absolute;inset:0;background-image:
    linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,0.02) 1px,transparent 1px);
    background-size:24px 24px,24px 24px;pointer-events:none}
  .bar{display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:.5rem .75rem;
    background:rgba(0,0,0,.45);border-bottom:1px solid rgba(255,255,255,.08);backdrop-filter:blur(8px)}
  .title{font-size:.9rem;letter-spacing:.04em;text-transform:uppercase;opacity:.85}
  .controls{display:flex;align-items:center;gap:.4rem}
  .btn{display:inline-flex;align-items:center;gap:.4rem;padding:.4rem .6rem;border:1px solid rgba(255,255,255,.12);
    border-radius:.5rem;background:rgba(12,12,16,.6);color:#e5e7eb;font-size:.8rem;cursor:pointer}
  .btn:hover{border-color:rgba(163,230,255,.6)}
.stage{
  height: var(--h);
  overflow: auto;
}

.canvas-wrap{
  width: max-content;            /* canvas can be wider than the stage */
  transform-origin: top left;
  transform: scale(var(--z, 1)); /* ⬅ zoom via CSS only */
}

canvas{
  display: block;
  background:#0b0b0e;
  border-radius: .5rem;
  max-width: none;               /* don’t clamp canvas */
  height: auto;
}
  .footer{display:flex;justify-content:space-between;align-items:center;padding:.45rem .75rem;font-size:.75rem;opacity:.6;
    border-top:1px solid rgba(255,255,255,.08);background:rgba(0,0,0,.35)}
  .pg{min-width:2.2rem;text-align:center}
</style>

<style is:global>
/* Stop card hover-scale from affecting the PDF while hovered */
.box.group .viewer:hover { 
  transform: none !important; 
}

/* Keep the viewport fixed; let the PDF scroll inside */
.viewer .stage { 
  height: var(--h); 
  overflow: auto; 
}

/* Allow the PDF to grow when zooming (don’t clamp to container) */
.viewer canvas { 
  image-rendering: optimizeQuality;
  max-width: none; 
  height: auto; 
}

/* Stop any parent card/tile from scaling while the viewer is hovered */
.box.group:has(.viewer:hover),
.project-card:has(.viewer:hover),
.card:has(.viewer:hover),
.tile:has(.viewer:hover),
.grid > *:has(.viewer:hover) {
  transform: none !important;
}

</style>


<div class="viewer" id={id} data-pdf={pdf} style={`--h:${height}px`} tabindex="0">
  <div class="bar">
    <div class="title">{title}</div>
    <div class="controls">
      <button class="btn" data-act="prev">←</button>
      <span class="pg" data-el="page">1</span>/<span class="pg" data-el="pages">?</span>
      <button class="btn" data-act="next">→</button>
      <button class="btn" data-act="zoom-out" type="button">–</button>
      <button class="btn" data-act="zoom-in"  type="button">+</button>
      <button class="btn" data-act="fullscreen">Fullscreen</button>
      <a class="btn" href={pdf} target="_blank" rel="noopener noreferrer">Open</a>
      <a class="btn" href={pdf} download>Download</a>
    </div>
  </div>

  <div class="stage">
    <div class="canvas-wrap"><canvas></canvas></div>
  </div>

  <div class="footer">
  </div>

  <!-- Load PDF.js v3 UMD only once -->
  <script>
    if (!window.__pdfjsLoaded) {
      var s = document.createElement('script');
      s.src = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js";
      document.head.appendChild(s);
      window.__pdfjsLoaded = true;
    }
  </script>

  <!-- Inline controller scoped to THIS viewer -->
<script is:inline>
(function(){
  const root = document.currentScript.closest('.viewer');
  if (!root) return;

  const PDF_URL = root.getAttribute('data-pdf');
  const canvas = root.querySelector('canvas');
  const ctx = canvas.getContext('2d');
  const pageEl  = root.querySelector('[data-el="page"]');
  const pagesEl = root.querySelector('[data-el="pages"]');

  const stage   = root.querySelector('.stage');
  const wrap    = root.querySelector('.canvas-wrap');

  // CSS zoom factor (visual only, does not change layout)
  let z = 1;
  const setZ = (v)=>{
  z = Math.max(0.5, Math.min(4, v));
  wrap.style.setProperty('--z', z);
  queueRender(pageNum);     // ⬅ re-render at higher pixel density for sharpness
  };

  // pdf.js setup
  function waitPdf() {
    if (!window.pdfjsLib) return setTimeout(waitPdf, 30);
    start();
  }

  function start(){
    const pdfjsLib = window.pdfjsLib;
    pdfjsLib.GlobalWorkerOptions.workerSrc =
      "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

    let pdfDoc=null, pageNum=1, rendering=false;

    // Render one page to a base size that fits the stage width
    async function renderPage(num){
      if (rendering) return;
      rendering = true;
      const page = await pdfDoc.getPage(num);

      // Compute a "fit to stage width" viewport at base zoom = 1
      const stageWidth = Math.max(1, stage.clientWidth - 20); // padding allowance
      const naturalViewport = page.getViewport({ scale: 1 });
      const baseScale = stageWidth / naturalViewport.width;   // fit width
      const viewport = page.getViewport({ scale: baseScale });

      // Backing store for crispness
      // make backing store scale with zoom so it stays crisp
      const DPR = Math.min(window.devicePixelRatio || 1, 3);
      // how many real pixels per CSS pixel after zoom
      const pixelScale = Math.min(DPR * z, 64);   // clamp to keep perf reasonable

      canvas.width  = Math.floor(viewport.width  * pixelScale);
      canvas.height = Math.floor(viewport.height * pixelScale);

      // CSS (layout) size stays fixed — only .canvas-wrap scales visually
      canvas.style.width  = viewport.width + 'px';
      canvas.style.height = viewport.height + 'px';

      // tell pdf.js to render into the higher-res backing store
      const transform = pixelScale !== 1 ? [pixelScale, 0, 0, pixelScale, 0, 0] : null;



      ctx.setTransform(1,0,0,1,0,0);
      await page.render({ canvasContext: ctx, viewport, transform }).promise;

      pageEl.textContent = String(num);
      rendering = false;
    }

    function queueRender(n){ rendering ? setTimeout(()=>queueRender(n), 50) : renderPage(n); }
    function onPrev(){ if (pageNum>1){ pageNum--; queueRender(pageNum); } }
    function onNext(){ if (pdfDoc && pageNum < pdfDoc.numPages){ pageNum++; queueRender(pageNum); } }

    // Controls: ONLY change CSS zoom variable
    root.querySelector('[data-act="zoom-in"]') .addEventListener('click', e=>{ e.preventDefault(); setZ(z + 0.2); });
    root.querySelector('[data-act="zoom-out"]').addEventListener('click', e=>{ e.preventDefault(); setZ(z - 0.2); });
    root.querySelector('[data-act="prev"]')    .addEventListener('click', e=>{ e.preventDefault(); onPrev(); });
    root.querySelector('[data-act="next"]')    .addEventListener('click', e=>{ e.preventDefault(); onNext(); });

    const fsBtn = root.querySelector('[data-act="fullscreen"]');
    if (fsBtn) fsBtn.addEventListener('click', e=>{
      e.preventDefault();
      const el = root;
      if (!document.fullscreenElement) el.requestFullscreen?.(); else document.exitFullscreen?.();
    });

    // Refit base size on resize; keep same z
    let resizeTid;
    addEventListener('resize', ()=>{
      clearTimeout(resizeTid);
      resizeTid = setTimeout(()=> queueRender(pageNum), 150);
    });

    // Load
    pdfjsLib.getDocument({ url: PDF_URL }).promise
      .then(doc => { pdfDoc = doc; pagesEl.textContent = String(doc.numPages); return renderPage(pageNum); })
      .catch(err => console.error('PDF load error:', err));

    // Start at base zoom
    setZ(1);
  }

  waitPdf();
})();
</script>
</div>
