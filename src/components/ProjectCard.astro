---
// src/components/ProjectCard.astro
import type { Project } from "../data/projects";
import PDFViewer from "./PDFViewer.astro";

export interface Props { project: Project }
project: Project
  variant?: "full" | "title"  // <- add this
}
const { project, variant = "full" } = Astro.props
---

{variant === "title" ? (
  <article class="group">
    <h3 class="h1-condensed text-base md:text-lg uppercase tracking-wide">
      {project.href
        ? <a href={project.href} class="no-underline hover:underline">{project.title}</a>
        : project.title}
    </h3>
  </article>
) : (

<article class="box group" data-react>
  <div class="flex items-start justify-between">
    <h3 class="h1-condensed text-base md:text-lg uppercase tracking-wide">
      {project.href ? <a href={project.href} class="no-underline hover:underline">{project.title}</a> : project.title}
    </h3>
    {project.year && <span class="opacity-70 text-xs md:text-sm">{project.year}</span>}
  </div>

  {project.role && <div class="eyebrow mt-2">{project.role}</div>}

  {project.description && (
    <p class="mt-2 opacity-85 text-sm md:text-base">{project.description}</p>
  )}

  {project.tags && project.tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2 text-xs opacity-80">
      {project.tags.map((t) => <li class="px-2 py-0.5 rounded-sm border ink-border">{t}</li>)}
    </ul>
  )}

  <div class="mt-3">
    {project.href && (
      <a href={project.href} class="btn-red">
        View project <span class="chev">→</span>
      </a>
    )}
  </div>
</article>
